{
  "name": "nexcraft",
  "productName": "NexCraft",
  "version": "0.2.0",
  "description": "NexCraft: a Minecraft Java Edition server and mod manager for Windows",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "out/main/index.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:win": "npm run build && electron-builder --win zip --x64 --publish never",
    "test:live": "vitest run test/live"
  },
  "dependencies": {
    "smol-toml": "1.9.1",
    "yauzl": "^3.4.0",
    "yazl": "3.3.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.9.3",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "lucide-react": "^0.510.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^4.0.0"
  }
}
